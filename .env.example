# Supabase — Project Settings → API Keys
# Solo se usan del lado del servidor (Route Handlers), por eso NO llevan NEXT_PUBLIC_.
# Si SUPABASE_SECRET_KEY se deja vacía, la app usa el Postgres local (PGlite).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Solo para aplicar el SQL con `npm run db:migrate` (Settings → Database).
DATABASE_URL=""

# Código que pide la app para eliminar una estación desde el mapa.
# Sin él, el borrado queda deshabilitado. En Vercel va en Environment Variables.
STATION_DELETE_CODE=""
